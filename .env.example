# ==========================================
# Naukri.com Credentials
# ==========================================
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram User IDs allowed to control the bot (get your ID from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=123456789

# ==========================================
# Scheduler Settings
# ==========================================
# Time in 24-hr format. Single (09:00) or multiple comma-separated (09:00,12:30)
DAILY_UPDATE_TIME=09:00
DAILY_UPDATE_TIMES=09:00,12:30
TIMEZONE=Asia/Kolkata

# ==========================================
# Headline (one-time seed - copy exactly from naukri.com/mnjuser/profile)
# The bot toggles a trailing "." on this at 09:00 + 12:30 automatically.
# You can also set it via Telegram: /set_headline <text>
# ==========================================
BASE_HEADLINE=

# ==========================================
# Automation Options (basic CLI server: no browser needed)
# ==========================================
HEADLESS=true
SESSION_FILE_PATH=data/session.json

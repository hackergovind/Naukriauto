# ==========================================
# Naukri.com Credentials
# ==========================================
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# ==========================================
# Telegram Bot Configuration
# ==========================================
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram User IDs allowed to control the bot (get your ID from @userinfobot)
ALLOWED_TELEGRAM_USER_IDS=123456789

# ==========================================
# Scheduler Settings
# ==========================================
# Time in 24-hr format (e.g. 09:00 for 9:00 AM)
DAILY_UPDATE_TIME=09:00
TIMEZONE=Asia/Kolkata

# ==========================================
# Headless & Automation Options
# ==========================================
HEADLESS=true
SESSION_FILE_PATH=data/session.json
SCREENSHOT_DIR=data
